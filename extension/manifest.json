{
  "manifest_version": 3,
  "name": "Quanto falta · PUCPR",
  "version": "0.7.0",
  "description": "Mostra no Canvas da PUCPR quanto falta para passar em cada matéria, baixa os arquivos das matérias e leva as notas para a calculadora.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quanto falta",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://pucpr.instructure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pucpr.instructure.com/*"
      ],
      "js": [
        "collect.js",
        "core.js",
        "files.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://falta-quanto.vercel.app/"
}
